{
  "expo": {
    "name": "Gotalk",
    "slug": "gotalk",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "gotalk",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F11",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sh.gotalk.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "sh.gotalk.app",
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Gotalk uses the camera when you turn it on in a voice channel.",
          "microphonePermission": "Gotalk uses the microphone so others can hear you in voice channels."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6646fc47-a6d7-440b-a332-d4dbe86cd436"
      }
    },
    "owner": "wyrdbox"
  }
}
